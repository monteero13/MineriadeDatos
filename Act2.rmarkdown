## Máquinas de Vectores de Soporte

::: panel-tabset
### Algoritmo sin Filtrado


```{r, message=FALSE, warning=FALSE}
# Configurar validación cruzada externa (5x2)
set.seed(123)
pliegues_externos <- 5
pliegues_internos <- 2
folds_externos <- createFolds(data$RCP, k = pliegues_externos, list = FALSE)
n <- nrow(data)

# Inicializar vectores para resultados
auc_scores <- numeric(pliegues_externos)
accuracy_scores <- numeric(pliegues_externos)
recall_scores <- numeric(pliegues_externos)
specificity_scores <- numeric(pliegues_externos)

# Matrices para predicciones y valores reales
pred_matrix <- matrix(NA, nrow = n, ncol = pliegues_externos)
true_values <- numeric(n)

# Bucle principal de validación cruzada externa
for (fold_idx in 1:pliegues_externos) {
  test_idx <- which(folds_externos == fold_idx)
  train_idx <- setdiff(1:n, test_idx)

  train_data <- data[train_idx, ]
  test_data <- data[test_idx, ]

  # Validación cruzada interna para selección de modelo
  inner_folds <- createFolds(train_data$RCP, k = pliegues_internos, list = FALSE)

  metrics_inner <- data.frame(auc = numeric(pliegues_internos),
                              acc = numeric(pliegues_internos),
                              recall = numeric(pliegues_internos),
                              specificity = numeric(pliegues_internos))

  for (inner_idx in 1:pliegues_internos) {
    val_idx <- which(inner_folds == inner_idx)
    subtrain_idx <- setdiff(1:nrow(train_data), val_idx)

    train_inner <- train_data[subtrain_idx, ]
    val_inner <- train_data[val_idx, ]

    best_score <- -Inf
    best_model <- NULL

    # Hiperparámetros óptimos identificados previamente
    kernel_opt <- "radial"
    cost_opt <- 100
    gamma_opt <- 0.1
    
    # Entrenar el modelo SVM con esos hiperparámetros
    best_model <- svm(RCP ~ ., data = train_inner, type = "C-classification",
                      kernel = kernel_opt, cost = cost_opt, gamma = gamma_opt, probability = TRUE)
    
    # Predecir probabilidades
    prob_val <- attr(predict(best_model, newdata = val_inner, probability = TRUE), "probabilities")[, "SI"]
    pred_class <- ifelse(prob_val >= 0.85, "SI", "NO")
    
    # Métricas de evaluación
    TP <- sum(pred_class == "SI" & val_inner$RCP == "SI")
    TN <- sum(pred_class == "NO" & val_inner$RCP == "NO")
    FP <- sum(pred_class == "SI" & val_inner$RCP == "NO")
    FN <- sum(pred_class == "NO" & val_inner$RCP == "SI")
    
    recall <- TP / (TP + FN)
    acc <- (TP + TN) / (TP + TN + FP + FN)
    specificity <- TN / (TN + FP)
    custom_score <- 0.8 * recall + 0.2 * acc
    
    # Calcular el AUC
    auc_val <- auc(roc(ifelse(val_inner$RCP == "SI", 1, 0), prob_val))


    metrics_inner$auc[inner_idx] <- auc_val
    metrics_inner$acc[inner_idx] <- acc
    metrics_inner$recall[inner_idx] <- recall
    metrics_inner$specificity[inner_idx] <- specificity
  }

  # Evaluar en conjunto de test externo
  final_prob <- attr(predict(best_model, newdata = test_data, probability = TRUE), "probabilities")[, "SI"]
  final_class <- ifelse(final_prob >= 0.5, "SI", "NO")

  TP <- sum(final_class == "SI" & test_data$RCP == "SI")
  TN <- sum(final_class == "NO" & test_data$RCP == "NO")
  FP <- sum(final_class == "SI" & test_data$RCP == "NO")
  FN <- sum(final_class == "NO" & test_data$RCP == "SI")

  auc_scores[fold_idx] <- auc(roc(ifelse(test_data$RCP == "SI", 1, 0), final_prob))
  accuracy_scores[fold_idx] <- (TP + TN) / (TP + TN + FP + FN)
  recall_scores[fold_idx] <- TP / (TP + FN)
  specificity_scores[fold_idx] <- TN / (TN + FP)

  pred_matrix[test_idx, fold_idx] <- final_prob
  true_values[test_idx] <- ifelse(test_data$RCP == "SI", 1, 0)
}

# Tabla de resultados por pliegue
tabla_resultados <- data.frame(
  Fold = 1:pliegues_externos,
  AUC = round(auc_scores, 3),
  Accuracy = round(accuracy_scores, 3),
  Recall = round(recall_scores, 3),
  Specificity = round(specificity_scores, 3)
)

# Agregar fila de promedios
promedios <- data.frame(
  Fold = "Mean",
  AUC = round(mean(auc_scores), 3),
  Accuracy = round(mean(accuracy_scores), 3),
  Recall = round(mean(recall_scores), 3),
  Specificity = round(mean(specificity_scores), 3)
)

tabla_final <- rbind(tabla_resultados, promedios)

# Mostrar tabla con estilo, colores y scroll
tabla_final %>%
  kable("html", caption = "Métricas de SVM sin Filtrado", align = "c") %>%
  kable_styling(full_width = TRUE, bootstrap_options = c("striped", "hover", "condensed")) %>%
  row_spec(0, background = "#002859", color = "white") %>%
  row_spec(1:(nrow(tabla_final) - 1), background = "#00AEDA", color = "black") %>%
  row_spec(nrow(tabla_final), background = "#007A99", color = "white", bold = TRUE) 
```


### Algoritmo con Filtrado


```{r, message=FALSE, warning=FALSE}
# Configurar validación cruzada externa (5x2)
set.seed(123)
pliegues_externos <- 5
pliegues_internos <- 2
folds_externos <- createFolds(data$RCP, k = pliegues_externos, list = FALSE)
n <- nrow(data)

# Inicializar vectores para resultados
auc_scores <- numeric(pliegues_externos)
accuracy_scores <- numeric(pliegues_externos)
recall_scores <- numeric(pliegues_externos)
specificity_scores <- numeric(pliegues_externos)

# Matrices para predicciones y valores reales
pred_matrix <- matrix(NA, nrow = n, ncol = pliegues_externos)
true_values <- numeric(n)

# Bucle principal de validación cruzada externa
for (fold_idx in 1:pliegues_externos) {
  test_idx <- which(folds_externos == fold_idx)
  train_idx <- setdiff(1:n, test_idx)

  train_data <- data[train_idx, ]
  test_data <- data[test_idx, ]

  # Validación cruzada interna para selección de modelo
  inner_folds <- createFolds(train_data$RCP, k = pliegues_internos, list = FALSE)

  metrics_inner <- data.frame(auc = numeric(pliegues_internos),
                              acc = numeric(pliegues_internos),
                              recall = numeric(pliegues_internos),
                              specificity = numeric(pliegues_internos))

  best_model <- NULL
  best_score_global <- -Inf

  for (inner_idx in 1:pliegues_internos) {
    val_idx <- which(inner_folds == inner_idx)
    subtrain_idx <- setdiff(1:nrow(train_data), val_idx)

    train_inner <- train_data[subtrain_idx, ]
    val_inner <- train_data[val_idx, ]

    # Filtrado de variables
    variables_seleccionadas <- metodo_filtrado(train_inner, "RCP")
    vars <- c("RCP", variables_seleccionadas)
    train_inner <- train_inner[, vars, drop = FALSE]
    val_inner <- val_inner[, vars, drop = FALSE]

    # Hiperparámetros óptimos
    kernel_opt <- "radial"
    cost_opt <- 100
    gamma_opt <- 0.1

    # Entrenar modelo
    best_model_fold <- svm(RCP ~ ., data = train_inner, type = "C-classification",
                           kernel = kernel_opt, cost = cost_opt, gamma = gamma_opt, probability = TRUE)

    # Validación
    prob_val <- attr(predict(best_model_fold, newdata = val_inner, probability = TRUE), "probabilities")[, "SI"]
    pred_class <- ifelse(prob_val >= 0.85, "SI", "NO")

    TP <- sum(pred_class == "SI" & val_inner$RCP == "SI")
    TN <- sum(pred_class == "NO" & val_inner$RCP == "NO")
    FP <- sum(pred_class == "SI" & val_inner$RCP == "NO")
    FN <- sum(pred_class == "NO" & val_inner$RCP == "SI")

    recall <- TP / (TP + FN)
    acc <- (TP + TN) / (TP + TN + FP + FN)
    specificity <- TN / (TN + FP)
    custom_score <- 0.8 * recall + 0.2 * acc
    auc_val <- auc(roc(ifelse(val_inner$RCP == "SI", 1, 0), prob_val))

    metrics_inner$auc[inner_idx] <- auc_val
    metrics_inner$acc[inner_idx] <- acc
    metrics_inner$recall[inner_idx] <- recall
    metrics_inner$specificity[inner_idx] <- specificity

    if (custom_score > best_score_global) {
      best_score_global <- custom_score
      best_model <- best_model_fold
      best_vars <- variables_seleccionadas
    }
  }

  # Evaluación en test externo con el mejor modelo encontrado
  test_data_filtrado <- test_data[, c("RCP", best_vars), drop = FALSE]
  final_prob <- attr(predict(best_model, newdata = test_data_filtrado, probability = TRUE), "probabilities")[, "SI"]
  final_class <- ifelse(final_prob >= 0.5, "SI", "NO")

  TP <- sum(final_class == "SI" & test_data_filtrado$RCP == "SI")
  TN <- sum(final_class == "NO" & test_data_filtrado$RCP == "NO")
  FP <- sum(final_class == "SI" & test_data_filtrado$RCP == "NO")
  FN <- sum(final_class == "NO" & test_data_filtrado$RCP == "SI")

  auc_scores[fold_idx] <- auc(roc(ifelse(test_data_filtrado$RCP == "SI", 1, 0), final_prob))
  accuracy_scores[fold_idx] <- (TP + TN) / (TP + TN + FP + FN)
  recall_scores[fold_idx] <- TP / (TP + FN)
  specificity_scores[fold_idx] <- TN / (TN + FP)

  pred_matrix[test_idx, fold_idx] <- final_prob
  true_values[test_idx] <- ifelse(test_data$RCP == "SI", 1, 0)
}

# Tabla de resultados por pliegue
tabla_resultados <- data.frame(
  Fold = 1:pliegues_externos,
  AUC = round(auc_scores, 3),
  Accuracy = round(accuracy_scores, 3),
  Recall = round(recall_scores, 3),
  Specificity = round(specificity_scores, 3)
)

# Fila de promedios
promedios <- data.frame(
  Fold = "Mean",
  AUC = round(mean(auc_scores), 3),
  Accuracy = round(mean(accuracy_scores), 3),
  Recall = round(mean(recall_scores), 3),
  Specificity = round(mean(specificity_scores), 3)
)

tabla_final <- rbind(tabla_resultados, promedios)

# Mostrar tabla
tabla_final %>%
  kable("html", caption = "Métricas de SVM con Filtrado", align = "c") %>%
  kable_styling(full_width = TRUE, bootstrap_options = c("striped", "hover", "condensed")) %>%
  row_spec(0, background = "#002859", color = "white") %>%
  row_spec(1:(nrow(tabla_final) - 1), background = "#00AEDA", color = "black") %>%
  row_spec(nrow(tabla_final), background = "#007A99", color = "white", bold = TRUE)
```


### Mejores Hiperparámetros


```{r, message=FALSE, warning=FALSE}
# Dividir el conjunto de datos en entrenamiento y test
set.seed(123)
indices_entrenamiento <- sample(nrow(data), 0.75 * nrow(data))
datos_entrenamiento <- data[indices_entrenamiento, ]
datos_test <- data[-indices_entrenamiento, ]

# Dividir datos de entrenamiento en entrenamiento y validación
train_indices <- sample(nrow(datos_entrenamiento), 0.8 * nrow(datos_entrenamiento))
datos_entrenamiento_split <- datos_entrenamiento[train_indices, ]
datos_validacion <- datos_entrenamiento[-train_indices, ]

# Inicializar resultados
mejor_auc <- 0
mejor_modelo <- NULL
resultados <- data.frame(kernel = character(), cost = numeric(), gamma = numeric(), auc = numeric(), stringsAsFactors = FALSE)

# Definir hiperparámetros
params <- expand.grid(cost = c(100, 1000, 10000, 50000, 1000000),
                      gamma = c(0.1, 1, 10),
                      kernel = c("linear", "radial", "sigmoid"))

# Entrenar y evaluar modelos
for (i in 1:nrow(params)) {
  modelo <- svm(RCP ~ ., data = datos_entrenamiento_split,
                type = "C-classification",
                kernel = params$kernel[i],
                cost = params$cost[i],
                gamma = params$gamma[i],
                probability = TRUE)

  predicciones_test <- predict(modelo, newdata = datos_test, probability = TRUE)
  probabilidades_test <- attr(predicciones_test, "probabilities")[, "SI"]

  roc_obj <- roc(ifelse(datos_test$RCP == "SI", 1, 0), probabilidades_test)
  auc_actual <- as.numeric(auc(roc_obj))

  resultados <- resultados %>%
    add_row(kernel = params$kernel[i], cost = params$cost[i], gamma = params$gamma[i], auc = auc_actual)

  if (auc_actual > mejor_auc) {
    mejor_auc <- auc_actual
    mejor_modelo <- modelo
  }
}

# Ordenar resultados
resultados_ordenados_svm <- resultados %>% arrange(desc(auc))

# Mostrar tabla estilizada
resultados_ordenados_svm %>%
  mutate(across(where(is.numeric), round, 4)) %>%
  kable("html", caption = "Resumen de combinaciones de hiperparámetros evaluadas con SVM", align = "c") %>%
  kable_styling(full_width = TRUE, bootstrap_options = c("striped", "hover", "condensed")) %>%
  row_spec(0, background = "#002859", color = "white") %>%
  row_spec(1:nrow(resultados_ordenados_svm), background = "#00AEDA", color = "black") %>%
  scroll_box( height = "400px", fixed_thead = TRUE)
```

:::

## Árboles de Decisión

::: panel-tabset
### Algoritmo sin Filtrado


```{r, message=FALSE, warning=FALSE}
# Validación cruzada 5x2
set.seed(123)
k_outer <- 5
k_inner <- 2
folds_outer <- createFolds(data$RCP, k = k_outer, list = FALSE)
indices <- 1:nrow(data)

# Inicializar métricas
resultados_auc <- numeric(k_outer)
resultados_accuracy <- numeric(k_outer)
resultados_sensibilidad <- numeric(k_outer)
resultados_specificity <- numeric(k_outer)

# Iterar por cada pliegue externo
for (i_outer in 1:k_outer) {
  test_indices_outer <- indices[folds_outer == i_outer]
  train_indices_outer <- setdiff(indices, test_indices_outer)
  
  train_outer <- data[train_indices_outer, ]
  test_outer <- data[test_indices_outer, ]
  
  folds_inner <- createFolds(train_outer$RCP, k = k_inner, list = FALSE)
  resultados_auc_inner <- numeric(k_inner)
  resultados_accuracy_inner <- numeric(k_inner)
  resultados_sensibilidad_inner <- numeric(k_inner)
  resultados_specificity_inner <- numeric(k_inner)
  
  for (i_inner in 1:k_inner) {
    test_indices_inner <- which(folds_inner == i_inner)
    train_indices_inner <- setdiff(1:nrow(train_outer), test_indices_inner)
    
    train_inner <- train_outer[train_indices_inner, ]
    val_inner <- train_outer[test_indices_inner, ]
    
    # Búsqueda de hiperparámetros
    param_grid <- expand.grid(cp = c(0.01, 0.05, 0.1),
                              minsplit = c(5, 10, 20),
                              minbucket = c(5, 10, 20))
    
    mejor_auc <- 0
    mejor_modelo <- NULL
    
    for (params in 1:nrow(param_grid)) {
      cp <- param_grid$cp[params]
      minsplit <- param_grid$minsplit[params]
      minbucket <- param_grid$minbucket[params]
      
      modelo <- rpart(RCP ~ ., data = train_inner,
                      method = "class",
                      control = rpart.control(cp = cp, minsplit = minsplit, minbucket = minbucket))
      
      prob <- predict(modelo, newdata = val_inner, type = "prob")[, "SI"]
      roc_obj <- roc(val_inner$RCP, prob, levels = rev(levels(val_inner$RCP)))
      auc_val <- auc(roc_obj)
      
      if (auc_val > mejor_auc) {
        mejor_auc <- auc_val
        mejor_modelo <- modelo
      }
    }
    
    # Evaluar modelo en validación interna
    prob <- predict(mejor_modelo, newdata = val_inner, type = "prob")[, "SI"]
    pred <- ifelse(prob >= 0.85, "SI", "NO")
    
    TP <- sum(pred == "SI" & val_inner$RCP == "SI")
    FN <- sum(pred == "NO" & val_inner$RCP == "SI")
    FP <- sum(pred == "SI" & val_inner$RCP == "NO")
    TN <- sum(pred == "NO" & val_inner$RCP == "NO")
    
    recall <- TP / (TP + FN)
    accuracy <- (TP + TN) / (TP + TN + FP + FN)
    specificity <- TN / (TN + FP)
    
    resultados_auc_inner[i_inner] <- mejor_auc
    resultados_accuracy_inner[i_inner] <- accuracy
    resultados_sensibilidad_inner[i_inner] <- recall
    resultados_specificity_inner[i_inner] <- specificity
  }
  
  resultados_auc[i_outer] <- mean(resultados_auc_inner)
  resultados_accuracy[i_outer] <- mean(resultados_accuracy_inner)
  resultados_sensibilidad[i_outer] <- mean(resultados_sensibilidad_inner)
  resultados_specificity[i_outer] <- mean(resultados_specificity_inner)
}

# Construir tabla de resultados
tabla_metricas <- data.frame(
  Pliegue = 1:k_outer,
  AUC = round(resultados_auc, 3),
  Accuracy = round(resultados_accuracy, 3),
  Recall = round(resultados_sensibilidad, 3),
  Specificity = round(resultados_specificity, 3)
)

# Agregar promedio
tabla_metricas <- rbind(tabla_metricas, data.frame(
  Pliegue = "Mean",
  AUC = round(mean(resultados_auc), 3),
  Accuracy = round(mean(resultados_accuracy), 3),
  Recall = round(mean(resultados_sensibilidad), 3),
  Specificity = round(mean(resultados_specificity), 3)
))

tabla_metricas %>%
  kable("html", caption = "Métricas de DT sin Filtrado") %>%
  kable_styling(full_width = TRUE, bootstrap_options = c("striped", "hover", "condensed")) %>%
  row_spec(0, background = "#002859", color = "white") %>%
  row_spec(1:(nrow(tabla_metricas)-1), background = "#00AEDA") %>%
  row_spec(nrow(tabla_metricas), background = "#007A99", color = "white", bold = TRUE)
```


### Algoritmo con Filtrado


```{r, message=FALSE, warning=FALSE}

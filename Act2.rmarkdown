```{r, echo=FALSE}

muestra_700_UGC_perdidos <- read_excel("muestra_700_UGC_perdidos.xlsx")

# Convertir variables character en factor
muestra_700_UGC_perdidos <- muestra_700_UGC_perdidos %>%
  mutate_if(is.character, as.factor)

muestra_700_UGC_perdidos$Tn <- factor(muestra_700_UGC_perdidos$Tn)
muestra_700_UGC_perdidos$GRADO <- factor(muestra_700_UGC_perdidos$GRADO)
muestra_700_UGC_perdidos$Nx <- factor(muestra_700_UGC_perdidos$Nx)

variables_a_analizar <- c("EDAD_DIAGNOSTICO", "ESTADO_MENOPAUSICO", "HISTOLOGIA", "GRADO", "KI67_DICOT", "Ki67", "FENOTIPO_IHQ", "TAMAÑO", "Tn", "Nx", "ESTADIO", "TIPO_CIRUGIA", "TIPO_QT_NEOADY_OK", "RCB", "HT_ADY_OK", "RE", "RP", "RETRASOS", "No_ANTIBIOTICOS", "FECHA_ULTIMO_CONTROL", "FECHA_INICIO_QT", "FECHA_DIAGNOSTICO", "ESTADO_ULTIMO_\nCONTROL", "ANTIBIOTICO")

df_procesado <- procesar_datos(muestra_700_UGC_perdidos, variables_a_analizar)

df_procesado$EDAD_DIAGNOSTICO <- cut(df_procesado$EDAD_DIAGNOSTICO, breaks = c(-Inf, 39, 49, 59,69,79, Inf), labels = c("0-39", "40-49", "50-59", "60-69","70-79","≥80"))

df_procesado$EDAD_DIAGNOSTICO <- as.factor(df_procesado$EDAD_DIAGNOSTICO)

df_procesado <- df_procesado %>%
  mutate(
    FECHA_DIAGNOSTICO = dmy(FECHA_DIAGNOSTICO),
    FECHA_DIAGNOSTICO = cut(
      year(FECHA_DIAGNOSTICO),
      breaks = seq(2000, 2030, by = 10),
      labels = c("2000-2009", "2010-2019", "2020-2029"),
      right = FALSE
    ),
    FECHA_DIAGNOSTICO = as.factor(FECHA_DIAGNOSTICO)
  )

df_procesado <- df_procesado %>%
  mutate(
    FECHA_ULTIMO_CONTROL = dmy(FECHA_ULTIMO_CONTROL),
    FECHA_ULTIMO_CONTROL = cut(
      year(FECHA_ULTIMO_CONTROL),
      breaks = seq(2000, 2030, by = 10),
      labels = c("2000-2009", "2010-2019", "2020-2029"),
      right = FALSE
    ),
    FECHA_ULTIMO_CONTROL = as.factor(FECHA_ULTIMO_CONTROL)
  )

df_procesado <- df_procesado %>%
  mutate(
    FECHA_INICIO_QT = dmy(FECHA_INICIO_QT),
    FECHA_INICIO_QT = cut(
      year(FECHA_INICIO_QT),
      breaks = seq(2000, 2030, by = 10),
      labels = c("2000-2009", "2010-2019", "2020-2029"),
      right = FALSE
    ),
    FECHA_INICIO_QT = as.factor(FECHA_INICIO_QT)
  )

# Seleccionar variables numéricas
numeric_vars <- sapply(df_procesado, is.numeric)

# Excluir 'Ki67' y 'No_ANTIBIOTICOS' de la normalización
vars_a_normalizar <- setdiff(names(df_procesado)[numeric_vars], c("Ki67", "No_ANTIBIOTICOS"))

# Normalizar solo esas variables
normalized_data <- scale(df_procesado[, vars_a_normalizar])

# Reemplazar las columnas originales por las normalizadas
df_procesado[, vars_a_normalizar] <- normalized_data

dataset_recodificado <- preprocesar_datos(df_procesado)

# Eliminar niveles no usados
dataset_recodificado <- droplevels(dataset_recodificado)

# Eliminar columnas innecesarias
dataset_recodificado <- subset(dataset_recodificado, select = -c(ANTIBIOTICO, GRADO, HISTOLOGIA, Ki67, KI67_DICOT, FENOTIPO_IHQ, ESTADIO, TIPO_QT_NEOADY_OK,No_ANTIBIOTICOS, RCB))

# Arreglar nombre de columna malformado
names(dataset_recodificado)[names(dataset_recodificado) == "ESTADO_ULTIMO_\nCONTROL"] <- "ESTADO_ULTIMO_CONTROL"
```


Si bien en la Actividad 1 ya se realizó un análisis preliminar de predicciones en la @sec-predicciones, en esta fase se profundiza dicho estudio aplicando el modelo óptimo identificado y validándolo de manera más rigurosa. Es importante señalar que el modelo utilizado anteriormente fue seleccionado únicamente en función del menor valor de AIC, sin considerar otras métricas de desempeño como el AUC. No obstante, dado que el objetivo principal en esta etapa es identificar el modelo con mayor capacidad predictiva, se prioriza el valor del AUC como criterio fundamental para la selección del modelo óptimo.

Durante la Actividad 1 también se incurrió en un enfoque metodológico limitado en el proceso de selección de variables, al escoger manualmente un conjunto de predictores considerados a priori como relevantes con respecto al evento RCP. Esta estrategia redujo significativamente la capacidad de los métodos automáticos de selección tipo *wrapper* para evaluar el conjunto completo de predictores disponibles y construir un modelo verdaderamente optimizado. Por este motivo, se ha repetido todo el procedimiento de selección de variables, permitiendo que los algoritmos operen sobre el dataset completo y seleccionen, de manera objetiva, el subconjunto de variables con mayor valor predictivo.

Adicionalmente, con el propósito de mejorar la calidad del análisis y maximizar el desempeño de los modelos generados, se ha llevado a cabo un tratamiento de datos más riguroso. En primer lugar, se ha categorizado la variable `EDAD_DIAGNOSTICO` en intervalos clínicamente relevantes: `0-39`, `40-49`, `50-59`, `60-69`, `70-79` y `≥80`, una práctica común en estudios epidemiológicos y clínicos para facilitar la interpretación y captar no linealidades en la relación entre edad y resultados clínicos (véase Altman, D.G. et al., 1991, *BMJ*, sobre categorización en modelos clínicos).

Asimismo, se ha transformado la información temporal relacionada con `FECHA_DIAGNOSTICO`, `FECHA_ULTIMO_CONTROL` y `FECHA_INICIO_QT`, agrupándolas en periodos decenales (`2000-2009`, `2010-2019` y `2020-2029`). Esta recodificación permite captar patrones temporales más amplios sin introducir ruido innecesario por fechas específicas.

Por otro lado, las variables numéricas del dataset han sido normalizadas para garantizar una escala comparable entre predictores continuos, a excepción de `Ki67` y `No_ANTIBIOTICOS`, que se utilizaron como base para procesos de recodificación categórica y no forman parte del análisis en su forma continua.

Este enfoque revisado ha permitido desarrollar modelos más robustos y comparables, optimizando la selección de variables y mejorando las condiciones del análisis predictivo.


```{r, eval=FALSE}

df_procesado$EDAD_DIAGNOSTICO <- cut(df_procesado$EDAD_DIAGNOSTICO, breaks = c(-Inf, 39, 49, 59,69,79, Inf), labels = c("0-39", "40-49", "50-59", "60-69","70-79","≥80"))

df_procesado$EDAD_DIAGNOSTICO <- as.factor(df_procesado$EDAD_DIAGNOSTICO)

df_procesado <- df_procesado %>%
  mutate(
    FECHA_DIAGNOSTICO = dmy(FECHA_DIAGNOSTICO),
    FECHA_DIAGNOSTICO = cut(
      year(FECHA_DIAGNOSTICO),
      breaks = seq(2000, 2030, by = 10),
      labels = c("2000-2009", "2010-2019", "2020-2029"),
      right = FALSE
    ),
    FECHA_DIAGNOSTICO = as.factor(FECHA_DIAGNOSTICO)
  )

df_procesado <- df_procesado %>%
  mutate(
    FECHA_ULTIMO_CONTROL = dmy(FECHA_ULTIMO_CONTROL),
    FECHA_ULTIMO_CONTROL = cut(
      year(FECHA_ULTIMO_CONTROL),
      breaks = seq(2000, 2030, by = 10),
      labels = c("2000-2009", "2010-2019", "2020-2029"),
      right = FALSE
    ),
    FECHA_ULTIMO_CONTROL = as.factor(FECHA_ULTIMO_CONTROL)
  )

df_procesado <- df_procesado %>%
  mutate(
    FECHA_INICIO_QT = dmy(FECHA_INICIO_QT),
    FECHA_INICIO_QT = cut(
      year(FECHA_INICIO_QT),
      breaks = seq(2000, 2030, by = 10),
      labels = c("2000-2009", "2010-2019", "2020-2029"),
      right = FALSE
    ),
    FECHA_INICIO_QT = as.factor(FECHA_INICIO_QT)
  )

numeric_vars <- sapply(df_procesado, is.numeric)

# Excluir 'Ki67' y 'No_ANTIBIOTICOS' de la normalización
vars_a_normalizar <- setdiff(names(df_procesado)[numeric_vars], c("Ki67", "No_ANTIBIOTICOS"))

normalized_data <- scale(df_procesado[, vars_a_normalizar])

df_procesado[, vars_a_normalizar] <- normalized_data
```

```{r, eval=FALSE}
skim(dataset_recodificado)
```

```{r, echo=FALSE}
skim(dataset_recodificado)
```


## Creación de modelos

::: {.panel-tabset style="max-height: 400px; overflow-y: auto;"}
### Modelo Básico


```{r, eval=FALSE}
dataset_modelo <- na.omit(dataset_recodificado)
dataset_modelo <- droplevels(dataset_modelo)

modelo_basico <- glm(formula= RCP ~ ., data = dataset_modelo, family = binomial("logit"))
```

```{r, echo=FALSE}
dataset_modelo <- na.omit(dataset_recodificado)
dataset_modelo <- droplevels(dataset_modelo)

modelo_basico <- glm(formula= RCP ~ ., data = dataset_modelo, family = binomial("logit"))
```


### Forward Selection


```{r, eval=FALSE}
mod_completo <- glm(RCP ~ .,data = dataset_modelo, family = binomial("logit"))

mod_basico <- glm(RCP ~ 1, data = dataset_modelo,
                  family = binomial("logit"))
mod_forward <- stepAIC(mod_basico, direction = "forward",
                        scope = list(lower = formula(mod_basico),
                                     upper = formula(mod_completo))
```

```{r, echo=FALSE, warning=FALSE}
mod_completo <- glm(RCP ~ .,data = dataset_modelo, family = binomial("logit"))

mod_basico <- glm(RCP ~ 1, data = dataset_modelo,
                  family = binomial("logit"))
mod_forward <- stepAIC(mod_basico, direction = "forward",
                        scope = list(lower = formula(mod_basico),
                                     upper = formula(mod_completo)))
```


### Backward Elimination


```{r, eval=FALSE}
mod_backward <- stepAIC(mod_completo, direction = "backward")
```

```{r, echo=FALSE, warning=FALSE}
mod_backward <- stepAIC(mod_completo, direction = "backward")
```


### Stepwise Regression


```{r, eval=FALSE}
mod_stepwise <- stepAIC(mod_basico, direction = "both",
                     scope = list(lower = formula(mod_basico),
                                  upper = formula(mod_completo)))
```

```{r, echo=FALSE, warning=FALSE}
mod_stepwise <- stepAIC(mod_basico, direction = "both",
                     scope = list(lower = formula(mod_basico),
                                  upper = formula(mod_completo)))
```

:::


clase <- ifelse(prob >= 0.5, "Sí", "No")
list(probabilidad = prob, clase = clase)
})
output$resultado_prediccion <- renderPrint({
req(prediccion())
cat("Probabilidad de RCP:", round(prediccion()$probabilidad, 4), "\n")
cat("Predicción:", prediccion()$clase)
})
output$grafico_prob <- renderPlot({
req(prediccion())
barplot(height = c(prediccion()$probabilidad, 1 - prediccion()$probabilidad),
names.arg = c("RCP: Sí", "RCP: No"),
col = c("#00AEDA", "#002859"),
ylim = c(0, 1),
main = "Probabilidad estimada de RCP")
})
}
shinyApp(ui = ui, server = server)

server <- function(input, output, session) {
# Tema dinámico según interruptor
observeEvent(input$modo_oscuro, {
if (input$modo_oscuro) {
tema(bs_theme(version = 5, bootswatch = "darkly", primary = "#00AEDA"))
} else {
tema(bs_theme(version = 5, bootswatch = "minty", primary = "#002859"))
}
})
output$tema_dynamic <- renderUI({
bs_themer(bootswatch = tema())
})
observeEvent(input$ayuda, {
toggle("texto_ayuda")
})
# Cálculo de la predicción
prediccion <- eventReactive(input$predecir, {
tamaño_input <- (input$tamano - media_tam) / sd_tam
re_input <- (input$re - media_re) / sd_re
nuevo <- data.frame(
EDAD_DIAGNOSTICO = factor(input$edad, levels = levels(dataset_modelo$EDAD_DIAGNOSTICO)),
TAMAÑO = tamaño_input,
Tn = factor(input$tn, levels = levels(dataset_modelo$Tn)),
RE = re_input,
ESTADO_ULTIMO_CONTROL = factor(input$estado, levels = levels(dataset_modelo$ESTADO_ULTIMO_CONTROL)),
QT_CAT = factor(input$qt, levels = levels(dataset_modelo$QT_CAT))
)
prob <- predict(modelo_rlog, newdata = nuevo, type = "response")
clase <- ifelse(prob >= 0.5, "Sí", "No")
list(probabilidad = prob, clase = clase)
})
output$card_resultado <- renderUI({
req(prediccion())
prob <- round(prediccion()$probabilidad * 100, 1)
clase <- prediccion()$clase
color <- if (clase == "Sí") "#00AEDA" else "#002859"
icono <- if (clase == "Sí") "✅" else "❌"
mensaje <- if (clase == "Sí") "Alta probabilidad de RCP" else "Baja probabilidad de RCP"
confianza <- ifelse(prob > 80, "Alta confianza", ifelse(prob > 60, "Moderada confianza", "Confianza baja"))
div(
style = paste0("background-color:", color, "; color: white; padding: 20px; border-radius: 10px; text-align: center;"),
h4("Resultado de la predicción"),
tags$h1(icono),
tags$h3(mensaje),
tags$p(paste("Probabilidad estimada:", prob, "%")),
tags$strong(paste("Fiabilidad del modelo:", confianza)),
tags$hr(),
tags$small("Esta predicción se basa en un modelo de regresión logística entrenado con datos clínicos normalizados.")
)
})
output$grafico_prob <- renderPlot({
req(prediccion())
prob <- prediccion()$probabilidad
barplot(
height = c(prob, 1 - prob),
names.arg = c("RCP: Sí", "RCP: No"),
col = c("#00AEDA", "#002859"),
ylim = c(0, 1),
main = "Distribución de la Probabilidad Estimada"
)
})
}
